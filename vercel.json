{
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "capanomics.com"
        }
      ],
      "destination": "https://capmechanics.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.capanomics.com"
        }
      ],
      "destination": "https://capmechanics.com/:path*",
      "permanent": true
    }
  ]
}